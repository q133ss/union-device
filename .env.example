# Скопируйте в .env и заполните. Файл .env в .gitignore — ключи в код не попадают.

# OpenAI-совместимый эндпоинт. Примеры:
#   OpenAI        https://api.openai.com/v1        модель gpt-4o-mini
#   OpenRouter    https://openrouter.ai/api/v1     модель openai/gpt-4o-mini
#   DeepSeek      https://api.deepseek.com/v1      модель deepseek-chat
#   Ollama (локально) http://localhost:11434/v1    модель qwen2.5:7b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Необязательные настройки
LLM_TIMEOUT=90
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
# JSON-режим (response_format=json_object). Выключите, если провайдер его не поддерживает.
LLM_JSON_MODE=true
